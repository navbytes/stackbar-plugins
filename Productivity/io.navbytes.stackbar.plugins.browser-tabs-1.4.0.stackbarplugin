  "source" : "import StackbarKit\nimport Foundation\n\n/// Your open browser tabs and your bookmarks in the palette, as Raycast's\n/// browser extensions have them: type part of a page's title or address and\n/// Return switches to that tab, or opens the bookmark.\n///\n/// Tabs come from Safari, Chrome, Arc, Brave and Edge while they run, read\n/// with AppleScript (macOS asks once to let Stackbar control each browser).\n/// Bookmarks come from the bookmark file Chrome, Brave, Edge and Vivaldi\n/// keep in every profile; Safari's are behind Full Disk Access, so they\n/// aren't read.\n@main\nfinal class BrowserTabs: StackbarPlugin {\n    struct Browser: Sendable {\n        var name: String\n        var bundleID: String\n        /// AppleScript dialect for tabs: Safari's or Chromium's.\n        var safari: Bool\n        /// The user-data folder of a Chromium browser: `Local State` names\n        /// its profiles, and each profile folder (`Default`, `Profile 1`…)\n        /// holds a `Bookmarks` file.\n        var dataFolder: String?\n    }\n\n    static let browsers: [Browser] = [\n        Browser(name: \"Safari\", bundleID: \"com.apple.Safari\", safari: true),\n        Browser(name: \"Google Chrome\", bundleID: \"com.google.Chrome\", safari: false, dataFolder: \"~/Library/Application Support/Google/Chrome\"),\n        Browser(name: \"Arc\", bundleID: \"company.thebrowser.Browser\", safari: false),\n        Browser(name: \"Brave Browser\", bundleID: \"com.brave.Browser\", safari: false, dataFolder: \"~/Library/Application Support/BraveSoftware/Brave-Browser\"),\n        Browser(name: \"Microsoft Edge\", bundleID: \"com.microsoft.edgemac\", safari: false, dataFolder: \"~/Library/Application Support/Microsoft Edge\"),\n        Browser(name: \"Vivaldi\", bundleID: \"com.vivaldi.Vivaldi\", safari: false, dataFolder: \"~/Library/Application Support/Vivaldi\"),\n    ]\n\n    static let manifest = Manifest(\n        id: \"io.navbytes.stackbar.plugins.browser-tabs\",\n        name: \"Browser Tabs\",\n        version: \"1.4.0\",\n        summary: \"Switch to any open tab in Safari, Chrome, Arc, Brave or Edge, and search your bookmarks.\",\n        surfaces: [.panel],\n        // Leaving a browser is when its tabs change: they're read again then, in\n        // the background, so the next search starts from a fresh list.\n        triggers: [.launch, .frontApp],\n        capabilities: [\n            .run(commands: [\"osascript\", \"cat\"]),\n            // Which browsers are running, so a browser that isn't is never\n            // started or asked for.\n            .apps,\n            .files(paths: browsers.compactMap(\\.dataFolder)),\n        ],\n        minimumStackbar: \"0.36.0\",\n        homepage: \"https://github.com/navbytes/stackbar-plugins/tree/main/Productivity/BrowserTabs\",\n        accent: .cyan,\n        symbol: \"rectangle.stack.fill\"\n    )\n\n    static let previews: [PreviewScene<BrowserTabs>] = [\n        PreviewScene(\"hero\", \"Every tab, a few letters away\") { plugin in\n            plugin.tabs = [\n                Tab(browser: \"Safari\", window: 1, index: 2, title: \"Pull requests · navbytes/stackbar\", url: \"https://github.com/navbytes/stackbar/pulls\"),\n                Tab(browser: \"Google Chrome\", window: 1, index: 1, title: \"Stackbar — your Mac, one keystroke away\", url: \"https://stackbar.app/\"),\n                Tab(browser: \"Arc\", window: 1, index: 4, title: \"Swift Forums\", url: \"https://forums.swift.org/\"),\n            ]\n            plugin.bookmarks = [Bookmark(title: \"Apple Developer Documentation\", url: \"https://developer.apple.com/documentation/\", folder: \"Bookmarks Bar › Docs\", browser: \"Google Chrome\")]\n            plugin.tabsReadAt = Date()\n        },\n        PreviewScene(\"browsers\", \"Safari, Chrome, Arc, Brave and Edge in one list\") { plugin in\n            plugin.tabs = [\n                Tab(browser: \"Safari\", window: 1, index: 1, title: \"Inbox · Fastmail\", url: \"https://app.fastmail.com/mail/Inbox\"),\n                Tab(browser: \"Google Chrome\", window: 1, index: 3, title: \"Q4 roadmap — Docs\", url: \"https://docs.google.com/document/d/abc\"),\n                Tab(browser: \"Arc\", window: 1, index: 2, title: \"Swift Forums\", url: \"https://forums.swift.org/\"),\n                Tab(browser: \"Brave Browser\", window: 2, index: 1, title: \"Hacker News\", url: \"https://news.ycombinator.com/\"),\n                Tab(browser: \"Microsoft Edge\", window: 1, index: 1, title: \"Azure Portal\", url: \"https://portal.azure.com/\"),\n            ]\n            plugin.tabsReadAt = Date()\n        },\n    ]\n\n    let theme = Theme.cyan\n\n    struct Tab: Equatable, Identifiable {\n        var browser: String\n        var window: Int\n        var index: Int\n        var title: String\n        var url: String\n        /// Lowercased once, so a keystroke doesn't allocate them again.\n        let lowerTitle: String\n        let lowerURL: String\n        var id: String { \"\\(browser)|\\(window)|\\(index)\" }\n\n        init(browser: String, window: Int, index: Int, title: String, url: String) {\n            (self.browser, self.window, self.index, self.title, self.url) = (browser, window, index, title, url)\n            (lowerTitle, lowerURL) = (title.lowercased(), url.lowercased())\n        }\n    }\n\n    struct Bookmark: Equatable, Identifiable {\n        var title: String\n        var url: String\n        var folder: String\n        var browser: String\n        /// The profile's name (\"Work\"), when the browser has more than one.\n        var profile: String?\n        /// Lowercased once, at load: a profile can hold thousands of bookmarks.\n        let lowerTitle: String\n        let lowerURL: String\n        var id: String { \"\\(browser)|\\(profile ?? \"\")|\\(folder)|\\(url)\" }\n\n        init(title: String, url: String, folder: String, browser: String, profile: String? = nil) {\n            (self.title, self.url, self.folder, self.browser, self.profile) = (title, url, folder, browser, profile)\n            (lowerTitle, lowerURL) = (title.lowercased(), url.lowercased())\n        }\n    }\n\n    var tabs: [Tab] = []\n    var tabsReadAt: Date?\n    /// The read running now: a search, a switch and a refresh that want the\n    /// tabs at once share it instead of each asking every browser.\n    var tabsReading: Task<Bool, Never>?\n    /// What the open Search Browser Tabs view has typed, so a read that lands\n    /// later shows the matches for it.\n    var tabQuery = \"\"\n    /// The app that was in front at the last `.frontApp`.\n    var frontApp: String?\n    var bookmarks: [Bookmark] = []\n    var bookmarksReadAt: Date?\n    var problems: [String] = []\n    var bookmarkProblems: [String] = []\n    var tabResults: [Tab] = []\n    var bookmarkResults: [Bookmark] = []\n\n    // MARK: Tabs\n\n    /// One line per tab: window, index, title and URL, split by tab\n    /// characters. The separators are made before `tell`: inside it, `tab`\n    /// is the browser's tab class, which joins as the word \"tab\", so no line\n    /// would split and every browser would look empty.\n    ///\n    /// Titles and addresses come in two Apple Events for the whole browser\n    /// (`… of every tab of every window`, one list per window), not two per\n    /// tab: on a Mac measured 2026-11-19 that took a Chrome read from about\n    /// 340 ms to 215 ms at 8 tabs, and the gap grows with every tab. The\n    /// lines are joined after `end tell`, which costs the browser nothing.\n    /// Only run for a browser that is running, so it never starts one.\n    static func listScript(_ browser: Browser) -> String {\n        let title = browser.safari ? \"name\" : \"title\"\n        return \"\"\"\n        set sep to character id 9\n        set nl to character id 10\n        set out to \"\"\n        tell application \"\\(browser.name)\"\n            set allTitles to \\(title) of every tab of every window\n            set allURLs to URL of every tab of every window\n        end tell\n        repeat with w from 1 to (count of allTitles)\n            set titles to item w of allTitles\n            set addresses to item w of allURLs\n            repeat with i from 1 to (count of titles)\n                set out to out & w & sep & i & sep & ((item i of titles) as text) & sep & ((item i of addresses) as text) & nl\n            end repeat\n        end repeat\n        return out\n        \"\"\"\n    }\n\n    /// The same lines read a tab at a time: for a browser whose dictionary\n    /// refuses the bulk form above.\n    static func perTabListScript(_ browser: Browser) -> String {\n        let title = browser.safari ? \"name of t\" : \"title of t\"\n        return \"\"\"\n        set sep to character id 9\n        set nl to character id 10\n        set out to \"\"\n        tell application \"\\(browser.name)\"\n            repeat with w from 1 to (count of windows)\n                set i to 0\n                repeat with t in (tabs of window w)\n                    set i to i + 1\n                    set out to out & w & sep & i & sep & (\\(title)) & sep & (URL of t) & nl\n                end repeat\n            end repeat\n        end tell\n        return out\n        \"\"\"\n    }\n\n    /// A Swift string as an AppleScript string literal.\n    static func quoted(_ text: String) -> String {\n        \"\\\"\" + text.replacingOccurrences(of: \"\\\\\", with: \"\\\\\\\\\").replacingOccurrences(of: \"\\\"\", with: \"\\\\\\\"\") + \"\\\"\"\n    }\n\n    /// Switches only when the tab read last is still in that slot with that\n    /// page, and says `moved` otherwise, so a switch needs no fresh read of\n    /// every tab first. Window numbers follow the browser's window order,\n    /// which changes as windows come forward: then the caller reads again.\n    static func checkedFocusScript(_ tab: Tab, safari: Bool) -> String {\n        \"\"\"\n        tell application \"\\(tab.browser)\"\n            if (count of windows) < \\(tab.window) then return \"moved\"\n            if (count of tabs of window \\(tab.window)) < \\(tab.index) then return \"moved\"\n            if (URL of tab \\(tab.index) of window \\(tab.window)) as text is not \\(quoted(tab.url)) then return \"moved\"\n        end tell\n        \\(focusScript(tab, safari: safari))\n        return \"ok\"\n        \"\"\"\n    }\n\n    static func focusScript(_ tab: Tab, safari: Bool) -> String {\n        if safari {\n            return \"\"\"\n            tell application \"Safari\"\n                set current tab of window \\(tab.window) to tab \\(tab.index) of window \\(tab.window)\n                set index of window \\(tab.window) to 1\n                activate\n            end tell\n            \"\"\"\n        }\n        if tab.browser == \"Arc\" {\n            return \"\"\"\n            tell application \"Arc\"\n                tell tab \\(tab.index) of window \\(tab.window) to select\n                activate\n            end tell\n            \"\"\"\n        }\n        return \"\"\"\n        tell application \"\\(tab.browser)\"\n            set active tab index of window \\(tab.window) to \\(tab.index)\n            set index of window \\(tab.window) to 1\n            activate\n        end tell\n        \"\"\"\n    }\n\n    static func closeScript(_ tab: Tab) -> String {\n        \"tell application \\\"\\(tab.browser)\\\" to close tab \\(tab.index) of window \\(tab.window)\"\n    }\n\n    static func parseTabs(_ text: String, browser: String) -> [Tab] {\n        text.split(separator: \"\\n\").compactMap { line in\n            // A title may hold tabs of its own, so the URL is the last field.\n            let fields = line.split(separator: \"\\t\", omittingEmptySubsequences: false).map(String.init)\n            guard fields.count >= 4, let window = Int(fields[0]), let index = Int(fields[1]), let url = fields.last, !url.isEmpty, url != \"missing value\" else { return nil }\n            let title = fields[2..<(fields.count - 1)].joined(separator: \"\\t\")\n            return Tab(browser: browser, window: window, index: index, title: title == \"missing value\" || title.isEmpty ? url : title, url: url)\n        }\n    }\n\n    /// How old the tabs may be before a search reads them again behind the\n    /// list it shows.\n    static let tabsFreshFor: TimeInterval = 2\n\n    /// Makes sure the tabs are read: at once when none have been read yet,\n    /// and not at all while the list is younger than `maxAge`. False when the\n    /// browsers couldn't be listed, so the tabs kept are older than asked for.\n    @discardableResult\n    func loadTabs(force: Bool = false, maxAge: TimeInterval = 5) async -> Bool {\n        if !force, let tabsReadAt, Date().timeIntervalSince(tabsReadAt) < maxAge { return true }\n        return await readTabs()\n    }\n\n    /// Reads every running browser's tabs. A read already running is shared,\n    /// unless `afterChange`: then the tabs changed since it started (a tab was\n    /// just closed), so a new read follows it.\n    @discardableResult\n    func readTabs(afterChange: Bool = false) async -> Bool {\n        if let running = tabsReading {\n            let read = await running.value\n            if !afterChange { return read }\n            // Someone else started the follow-up while this one waited.\n            if let next = tabsReading, next != running { return await next.value }\n        }\n        let task = Task { @MainActor in await self.readAllTabs() }\n        tabsReading = task\n        let read = await task.value\n        if tabsReading == task { tabsReading = nil }\n        return read\n    }\n\n    /// Stale-while-revalidate, as Raycast's `useCachedPromise` does it: a\n    /// search answers from the tabs already read and, when they are older\n    /// than `tabsFreshFor`, reads again behind them. The open view then\n    /// redraws with the matches for what is typed by then.\n    func revalidateTabs() {\n        guard tabsReading == nil else { return }\n        if let tabsReadAt, Date().timeIntervalSince(tabsReadAt) < Self.tabsFreshFor { return }\n        Task { @MainActor in\n            await self.readTabs()\n            self.tabResults = Self.matches(self.tabQuery, in: self.tabs, title: \\.lowerTitle, url: \\.lowerURL)\n            Stackbar.redraw()\n        }\n    }\n\n    private func readAllTabs() async -> Bool {\n        var found: [Tab] = []\n        var failed: [String] = []\n        let running: Set<String>\n        do {\n            running = Set(try await Stackbar.runningApps().map(\\.id))\n        } catch {\n            problems = [\"Can't see which browsers are running: \\(error)\"]\n            tabsReadAt = Date()\n            return false\n        }\n        // One script per running browser, side by side: a browser stuck on a\n        // dialog costs its own timeout, not everyone else's as well.\n        let outcomes = await withTaskGroup(of: (Int, String?, String?).self) { group in\n            for (position, browser) in Self.browsers.enumerated() where running.contains(browser.bundleID) {\n                group.addTask {\n                    let outcome = await Self.list(browser, script: Self.listScript(browser))\n                    // A browser that refuses the bulk form (not one that\n                    // refuses Stackbar) is read a tab at a time.\n                    if outcome.text == nil, let error = outcome.error, !Self.isAuthorization(error), error != Self.noAnswer {\n                        let again = await Self.list(browser, script: Self.perTabListScript(browser))\n                        return (position, again.text, again.error)\n                    }\n                    return (position, outcome.text, outcome.error)\n                }\n            }\n            var all: [(Int, String?, String?)] = []\n            for await outcome in group { all.append(outcome) }\n            return all.sorted { $0.0 < $1.0 }\n        }\n        for (position, text, errorText) in outcomes {\n            let browser = Self.browsers[position]\n            if let text {\n                found += Self.parseTabs(text, browser: browser.name)\n            } else if let errorText, Self.isAuthorization(errorText) {\n                failed.append(\"Allow Stackbar to control \\(browser.name) in System Settings › Privacy & Security › Automation.\")\n            } else if let errorText {\n                failed.append(\"Couldn't read \\(browser.name)'s tabs: \\(errorText.split(separator: \"\\n\").first.map(String.init) ?? Self.noAnswer)\")\n            }\n        }\n        tabs = found\n        problems = failed\n        tabsReadAt = Date()\n        return true\n    }\n\n    nonisolated static let noAnswer = \"it didn't answer\"\n\n    nonisolated static func isAuthorization(_ errorText: String) -> Bool {\n        errorText.contains(\"-1743\") || errorText.contains(\"Not authorized\")\n    }\n\n    /// One list script's output, or why there is none.\n    nonisolated static func list(_ browser: Browser, script: String) async -> (text: String?, error: String?) {\n        guard let result = try? await Stackbar.run(\"osascript\", [\"-e\", script], timeout: .seconds(10)) else { return (nil, noAnswer) }\n        return result.succeeded ? (result.text, nil) : (nil, result.errorText)\n    }\n\n    /// The tab as it is now, found by its page. Closing needs a sure match: the\n    /// same slot with the same title, or the page's only tab. Switching takes\n    /// the copy nearest the old place.\n    func current(_ tab: Tab, fresh: Bool, maxAge: TimeInterval = 5) async throws -> Tab {\n        let read = await loadTabs(force: fresh, maxAge: maxAge)\n        if fresh && !read { throw HostError(\"Couldn't check the tab. Try again.\") }\n        let pages = tabs.filter { $0.browser == tab.browser && $0.url == tab.url }\n        let sameTitle = pages.filter { $0.title == tab.title }\n        let candidates = sameTitle.isEmpty ? pages : sameTitle\n        if fresh {\n            if let slot = pages.first(where: { $0.window == tab.window && $0.index == tab.index }), slot.title == tab.title { return slot }\n            guard let only = candidates.first, candidates.count == 1 else {\n                if candidates.isEmpty { throw HostError(\"That tab has closed. Search your tabs again.\") }\n                throw HostError(\"More than one tab has that page. Close it from the browser.\")\n            }\n            return only\n        }\n        // The copy in the same window nearest the old index, then any window.\n        let nearest = candidates.min { lhs, rhs in\n            (lhs.window == tab.window ? 0 : 1, abs(lhs.index - tab.index)) < (rhs.window == tab.window ? 0 : 1, abs(rhs.index - tab.index))\n        }\n        if let nearest { return nearest }\n        throw HostError(\"That tab has closed. Search your tabs again.\")\n    }\n\n    /// Switches to the tab as last read, checking in the same script that it\n    /// is still there; only when it moved are the tabs read again first.\n    func focus(_ tab: Tab) async throws {\n        let safari = Self.browsers.first { $0.name == tab.browser }?.safari ?? false\n        let first = try await Stackbar.run(\"osascript\", [\"-e\", Self.checkedFocusScript(tab, safari: safari)], timeout: .seconds(10))\n        if first.succeeded, first.text.trimmingCharacters(in: .whitespacesAndNewlines) != \"moved\" { return }\n        if !first.succeeded, Self.isAuthorization(first.errorText) {\n            throw HostError(\"Allow Stackbar to control \\(tab.browser) in System Settings › Privacy & Security › Automation.\")\n        }\n        let moved = try await current(tab, fresh: false, maxAge: 0)\n        let result = try await Stackbar.run(\"osascript\", [\"-e\", Self.focusScript(moved, safari: safari)], timeout: .seconds(10))\n        guard result.succeeded else { throw HostError(\"Couldn't switch to the tab: \\(result.errorText.prefix(160))\") }\n    }\n\n    func close(_ tab: Tab) async throws {\n        let tab = try await current(tab, fresh: true)\n        let result = try await Stackbar.run(\"osascript\", [\"-e\", Self.closeScript(tab)], timeout: .seconds(10))\n        guard result.succeeded else { throw HostError(\"Couldn't close the tab: \\(result.errorText.prefix(160))\") }\n        await readTabs(afterChange: true)\n    }\n\n    // MARK: Bookmarks\n\n    /// Bookmarks kept in memory across every browser and profile. Search is\n    /// a scan of lowercased strings, so this is about memory, not speed;\n    /// past it the panel says how many were left out.\n    static let maxBookmarks = 20_000\n\n    /// A Chromium browser's profiles from its `Local State` file, as\n    /// (folder, name) pairs in the order the browser lists them, `Default`\n    /// first. Unreadable or empty: just `Default`, which every install has.\n    static func parseProfiles(_ data: Data) -> [(folder: String, name: String)] {\n        struct Info: Decodable { var name: String? }\n        struct Profiles: Decodable {\n            var info_cache: [String: Info]? // swiftlint:disable:this identifier_name\n            var profiles_order: [String]? // swiftlint:disable:this identifier_name\n        }\n        struct LocalState: Decodable { var profile: Profiles? }\n        guard let state = try? JSONDecoder().decode(LocalState.self, from: data),\n              let cache = state.profile?.info_cache, !cache.isEmpty else { return [(\"Default\", \"Default\")] }\n        // A folder name is used as a path, so nothing that could leave the\n        // browser's folder.\n        let folders = cache.keys.filter { !$0.isEmpty && !$0.contains(\"/\") && $0 != \".\" && $0 != \"..\" }\n        let order = state.profile?.profiles_order ?? []\n        let sorted = folders.sorted { lhs, rhs in\n            let rank = { (folder: String) -> (Int, Int, String) in\n                if folder == \"Default\" { return (0, 0, folder) }\n                if let index = order.firstIndex(of: folder) { return (1, index, folder) }\n                return (2, 0, folder)\n            }\n            return rank(lhs) < rank(rhs)\n        }\n        return sorted.map { folder in\n            let name = cache[folder]?.name?.trimmingCharacters(in: .whitespacesAndNewlines) ?? \"\"\n            return (folder, name.isEmpty ? folder : name)\n        }\n    }\n\n    /// Chromium's `Bookmarks` JSON: `roots` of folders with `children`.\n    static func parseBookmarks(_ data: Data, browser: String, profile: String? = nil) -> [Bookmark] {\n        struct Node: Decodable {\n            var type: String?\n            var name: String?\n            var url: String?\n            var children: [Node]?\n        }\n        struct File: Decodable { var roots: [String: Node] }\n        guard let file = try? JSONDecoder().decode(File.self, from: data) else { return [] }\n        var found: [Bookmark] = []\n        func walk(_ node: Node, path: [String]) {\n            if node.type == \"url\", let url = node.url, url.hasPrefix(\"http\") {\n                found.append(Bookmark(title: node.name?.isEmpty == false ? node.name! : url, url: url, folder: path.joined(separator: \" › \"), browser: browser, profile: profile))\n            }\n            for child in node.children ?? [] {\n                walk(child, path: node.type == \"folder\" ? path + [node.name ?? \"\"] : path)\n            }\n        }\n        for key in [\"bookmark_bar\", \"other\", \"synced\"] {\n            if let root = file.roots[key] { walk(root, path: []) }\n        }\n        return found\n    }\n\n    /// The bookmarks to keep: each address once (the first browser and\n    /// profile that has it wins), at most `limit`, and how many were left out.\n    static func kept(_ found: [Bookmark], limit: Int = maxBookmarks) -> (bookmarks: [Bookmark], leftOut: Int) {\n        var seen = Set<String>()\n        let unique = found.filter { seen.insert($0.url).inserted }\n        return (Array(unique.prefix(limit)), max(0, unique.count - limit))\n    }\n\n    /// A count in words: \"12,345\".\n    static func counted(_ number: Int) -> String {\n        let formatter = NumberFormatter()\n        formatter.numberStyle = .decimal\n        formatter.locale = Locale(identifier: \"en_US\")\n        return formatter.string(from: NSNumber(value: number)) ?? \"\\(number)\"\n    }\n\n    func loadBookmarks(force: Bool = false) async {\n        if !force, let bookmarksReadAt, Date().timeIntervalSince(bookmarksReadAt) < 300 { return }\n        var found: [Bookmark] = []\n        var failed: [String] = []\n        for browser in Self.browsers {\n            guard let dataFolder = browser.dataFolder else { continue }\n            // Which profiles there are. No folder means the browser isn't\n            // installed: as quiet as a missing file.\n            let profiles: [(folder: String, name: String)]\n            do {\n                let state = try await Stackbar.run(\"cat\", [\"Local State\"], workingDirectory: dataFolder, timeout: .seconds(10))\n                profiles = Self.parseProfiles(state.succeeded && !state.truncated ? state.stdout : Data())\n            } catch {\n                if !\"\\(error)\".contains(\"is not a folder\") {\n                    failed.append(\"Couldn't read \\(browser.name)'s bookmarks: \\(error)\")\n                }\n                continue\n            }\n            for profile in profiles {\n                let label = profiles.count > 1 ? profile.name : nil\n                let named = label.map { \"\\(browser.name) (\\($0))\" } ?? browser.name\n                let result: RunResult\n                do {\n                    result = try await Stackbar.run(\"cat\", [\"Bookmarks\"], workingDirectory: dataFolder + \"/\" + profile.folder, timeout: .seconds(10))\n                } catch {\n                    // A profile listed but never opened has no folder yet.\n                    if !\"\\(error)\".contains(\"is not a folder\") {\n 